    {
      "id": 17, "type": "text", "title": "Procedures and packet integrity", "gridPos": {"h": 3, "w": 24, "x": 0, "y": 38},
      "options": {"mode": "markdown", "content": "### Registration and session establishment stayed successful\nAll accepted registration and PDU-session attempts succeeded. Latency panels below show the median of three condition-level medians at the selected UE load. UDP loss was zero in all accepted conditions; this is an observed result, not a guarantee for future runs."}
    },
    {
      "id": 18, "type": "stat", "title": "Registration success", "description": "Accepted successful registrations divided by registration attempts at the selected UE load.", "gridPos": {"h": 6, "w": 6, "x": 0, "y": 41},
      "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "cn5g_performance_reviewed_procedure_success_ratio{procedure=\"registration\",ue_level=\"$ue_level\"}", "instant": true}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}, "overrides": []},
