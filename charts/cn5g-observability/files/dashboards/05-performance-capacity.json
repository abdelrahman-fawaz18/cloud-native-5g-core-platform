    {
      "id": 27, "type": "bargauge", "title": "Forward TCP distribution at selected load", "description": "Minimum, median, nearest-rank p95, and maximum aggregate forward TCP results across the three accepted repetitions at the selected UE load.", "gridPos": {"h": 9, "w": 12, "x": 0, "y": 68},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "expr": "cn5g_performance_reviewed_throughput_bits_per_second{direction=\"forward\",scope=\"aggregate\",ue_level=\"$ue_level\",statistic=~\"minimum|median|p95_nearest_rank|maximum\"}", "instant": true, "legendFormat": "{{statistic}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "bps", "min": 0, "color": {"mode": "continuous-BlPu"}}, "overrides": []},
