      "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "cn5g_performance_reviewed_procedure_success_ratio{procedure=\"pdu_session\",ue_level=\"$ue_level\"}", "instant": true}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "center", "reduceOptions": {"calcs": ["lastNotNull"], "values": false}}
    },
    {
      "id": 20, "type": "stat", "title": "UDP loss", "description": "Maximum UDP packet-loss ratio in accepted conditions at the selected UE load.", "gridPos": {"h": 6, "w": 6, "x": 12, "y": 41},
      "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "cn5g_performance_reviewed_udp_loss_ratio{ue_level=\"$ue_level\",statistic=\"maximum\"}", "instant": true}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 0.001}, {"color": "red", "value": 0.01}]}}, "overrides": []},
