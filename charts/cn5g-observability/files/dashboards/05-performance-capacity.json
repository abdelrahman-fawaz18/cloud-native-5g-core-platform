    },
    {
      "id": 23, "type": "bargauge", "title": "PDU-session latency by UE level", "description": "Median across three repetitions of the condition-level median PDU-session establishment latency.", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 47},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "cn5g_performance_reviewed_procedure_latency_seconds{procedure=\"pdu_session\",estimator=\"condition_median\",statistic=\"median\"}", "instant": true, "legendFormat": "{{ue_level}} UEs"}],
