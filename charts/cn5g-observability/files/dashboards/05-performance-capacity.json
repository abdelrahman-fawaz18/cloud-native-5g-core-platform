    },
    {
      "id": 15, "type": "bargauge", "title": "ICMP round-trip time", "description": "Median of the accepted condition-level average ICMP round-trip times. This is local user-space simulation latency, not radio latency.", "gridPos": {"h": 8, "w": 8, "x": 8, "y": 30},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "cn5g_performance_reviewed_icmp_rtt_seconds{statistic=\"median\"}", "instant": true, "legendFormat": "{{ue_level}} UEs"}],
