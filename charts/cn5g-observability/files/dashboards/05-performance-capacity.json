    },
    {
      "id": 16, "type": "bargauge", "title": "UDP jitter p95", "description": "Median of each accepted condition's p95 UDP jitter. With three repetitions, cross-run p95 statistics remain cautious descriptive evidence.", "gridPos": {"h": 8, "w": 8, "x": 16, "y": 30},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "cn5g_performance_reviewed_udp_jitter_seconds{statistic=\"median\"}", "instant": true, "legendFormat": "{{ue_level}} UEs"}],
