{
  "uid": "cn5g-reliability",
  "title": "CN5G Reliability And Recovery",
  "description": "Reviewed resilience campaign single-replica AMF, SMF, and UPF fault-recovery evidence. Kubernetes detection, Pod readiness, service recovery, and user-plane disruption are intentionally separate boundaries.",
  "tags": ["cn5g", "resilience", "reliability", "reviewed-evidence"],
  "timezone": "browser",
  "schemaVersion": 42,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
