{
  "uid":"cn5g-platform","title":"CN5G Platform Overview","tags":["cn5g","phase-06"],"timezone":"browser","schemaVersion":42,"version":1,"refresh":"15s",
  "time":{"from":"now-30m","to":"now"},
  "panels":[
    {"id":1,"type":"stat","title":"Prometheus targets up","gridPos":{"h":8,"w":6,"x":0,"y":0},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"sum(up)","legendFormat":"targets"}]},
    {"id":2,"type":"stat","title":"CN5G deployments available","gridPos":{"h":8,"w":6,"x":6,"y":0},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"sum(kube_deployment_status_replicas_available{namespace=\"cn5g\"})","legendFormat":"replicas"}]},
    {"id":3,"type":"stat","title":"Active alerts","gridPos":{"h":8,"w":6,"x":12,"y":0},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"sum(ALERTS{alertstate=\"firing\"}) or vector(0)","legendFormat":"alerts"}]},
    {"id":4,"type":"stat","title":"Ready UE probes","gridPos":{"h":8,"w":6,"x":18,"y":0},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"sum(cn5g_ue_user_plane_probe_success)","legendFormat":"UEs"}]},
    {"id":5,"type":"timeseries","title":"CN5G container CPU","gridPos":{"h":9,"w":12,"x":0,"y":8},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"cn5g\",container!=\"\"}[2m]))","legendFormat":"{{pod}}"}]},
    {"id":6,"type":"timeseries","title":"CN5G container memory","gridPos":{"h":9,"w":12,"x":12,"y":8},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"sum by (pod) (container_memory_working_set_bytes{namespace=\"cn5g\",container!=\"\"})","legendFormat":"{{pod}}"}]}
  ]
}
