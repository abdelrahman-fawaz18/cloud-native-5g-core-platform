{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CN5G Helm values",
  "type": "object",
  "additionalProperties": false,
  "required": ["global", "images", "subscriberSecret", "phase05", "phase06", "phase07", "mongodb", "open5gs", "ueransim", "dataNetwork", "subscriberJob"],
  "properties": {
    "global": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rolloutToken", "ranRolloutToken", "uePool", "ueGateway", "ueMtu", "plmn", "slice", "dnn"],
      "properties": {
        "rolloutToken": {"type": "string", "minLength": 1, "maxLength": 63},
        "ranRolloutToken": {"type": "string", "minLength": 1, "maxLength": 63},
        "uePool": {"const": "10.60.0.0/24"},
        "ueGateway": {"const": "10.60.0.1"},
        "ueMtu": {"const": 1400},
        "plmn": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mcc", "mnc", "tac"],
          "properties": {
            "mcc": {"const": "999"},
            "mnc": {"const": "70"},
            "tac": {"const": 1}
          }
        },
        "slice": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sst"],
          "properties": {"sst": {"const": 1}}
        },
        "dnn": {"const": "internet"}
      }
    },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": ["open5gs", "ueransim", "dataNetwork", "mongodb", "ueProbe", "benchmark"],
      "properties": {
        "open5gs": {"$ref": "#/$defs/localImage"},
        "ueransim": {"$ref": "#/$defs/localImage"},
        "dataNetwork": {"$ref": "#/$defs/localImage"},
        "mongodb": {"$ref": "#/$defs/registryImage"},
        "ueProbe": {"$ref": "#/$defs/pullableRegistryImage"},
        "benchmark": {"$ref": "#/$defs/localImage"}
      }
    },
    "subscriberSecret": {
      "type": "object",
      "additionalProperties": false,
      "required": ["existingSecret", "ueConfigKey", "subscriberScriptKey", "imsiKey"],
      "properties": {
        "existingSecret": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
        "ueConfigKey": {"const": "ue.yaml"},
        "subscriberScriptKey": {"const": "subscriber-init.js"},
        "imsiKey": {"const": "imsi"}
      }
    },
    "phase05": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "ueReplicas", "subscriberSecret", "sessions"],
      "properties": {
        "enabled": {"type": "boolean"},
        "ueReplicas": {"const": 5},
        "subscriberSecret": {
          "type": "object",
          "additionalProperties": false,
          "required": ["existingSecret", "planKey", "subscriberScriptKey"],
          "properties": {
            "existingSecret": {"const": "cn5g-subscribers-phase05"},
            "planKey": {"const": "plan.json"},
            "subscriberScriptKey": {"const": "subscriber-init.js"}
          }
        },
        "sessions": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            {"$ref": "#/$defs/internetSession"},
            {"$ref": "#/$defs/enterpriseSession"}
          ],
          "items": false
        }
      }
    },
    "phase06": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "probeIntervalSeconds", "metricsPort", "resources"],
      "properties": {
        "enabled": {"type": "boolean"},
        "probeIntervalSeconds": {"const": 15},
        "metricsPort": {"const": 9101},
        "resources": {"$ref": "#/$defs/resources"}
      }
    },
    "phase07": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "iperfPort", "iperfPortCount", "resources"],
      "properties": {
        "enabled": {"type": "boolean"},
        "iperfPort": {"const": 5201},
        "iperfPortCount": {"const": 5},
        "resources": {"$ref": "#/$defs/resources"}
      }
    },
    "mongodb": {"$ref": "#/$defs/storageWorkload"},
    "open5gs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resources", "upfResources"],
      "properties": {
        "resources": {"$ref": "#/$defs/resources"},
        "upfResources": {"$ref": "#/$defs/resources"}
      }
    },
    "ueransim": {"$ref": "#/$defs/workload"},
    "dataNetwork": {"$ref": "#/$defs/workload"},
    "subscriberJob": {"$ref": "#/$defs/workload"}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "phase07": {
            "properties": {"enabled": {"const": true}},
            "required": ["enabled"]
          }
        }
      },
      "then": {
        "properties": {
          "phase05": {"properties": {"enabled": {"const": true}}},
          "phase06": {"properties": {"enabled": {"const": true}}}
        }
      }
    }
  ],
  "$defs": {
    "pullPolicy": {"type": "string", "enum": ["Never", "IfNotPresent", "Always"]},
    "localImage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "pullPolicy", "expectedImageID"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string", "minLength": 1, "not": {"const": "latest"}},
        "pullPolicy": {"const": "Never"},
        "expectedImageID": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "registryImage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "digest", "pullPolicy", "expectedImageID"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string", "minLength": 1, "not": {"const": "latest"}},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "pullPolicy": {"const": "Never"},
        "expectedImageID": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "pullableRegistryImage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "digest", "pullPolicy", "expectedImageID"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string", "minLength": 1, "not": {"const": "latest"}},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "pullPolicy": {"const": "IfNotPresent"},
        "expectedImageID": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requests", "limits"],
      "properties": {
        "requests": {"$ref": "#/$defs/resourcePair"},
        "limits": {"$ref": "#/$defs/resourcePair"}
      }
    },
    "resourcePair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu", "memory"],
      "properties": {
        "cpu": {"type": ["string", "number"]},
        "memory": {"type": "string", "pattern": "^[0-9]+(Ki|Mi|Gi)$"}
      }
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resources"],
      "properties": {"resources": {"$ref": "#/$defs/resources"}}
    },
    "storageWorkload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["storageClassName", "storageSize", "resources"],
      "properties": {
        "storageClassName": {"type": "string", "minLength": 1},
        "storageSize": {"type": "string", "pattern": "^[1-9][0-9]*(Mi|Gi)$"},
        "resources": {"$ref": "#/$defs/resources"}
      }
    },
    "internetSession": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "pool", "gateway", "tunDevice", "endpoint", "routeTable", "rulePriority"],
      "properties": {
        "name": {"const": "internet"},
        "pool": {"const": "10.60.0.0/24"},
        "gateway": {"const": "10.60.0.1"},
        "tunDevice": {"const": "ogstun"},
        "endpoint": {"const": "data-internet"},
        "routeTable": {"const": 1060},
        "rulePriority": {"const": 1060}
      }
    },
    "enterpriseSession": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "pool", "gateway", "tunDevice", "endpoint", "routeTable", "rulePriority"],
      "properties": {
        "name": {"const": "enterprise"},
        "pool": {"const": "10.61.0.0/24"},
        "gateway": {"const": "10.61.0.1"},
        "tunDevice": {"const": "ogstun2"},
        "endpoint": {"const": "data-enterprise"},
        "routeTable": {"const": 1061},
        "rulePriority": {"const": 1061}
      }
    }
  }
}
