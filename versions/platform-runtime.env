# Accepted Helm release inputs for Ubuntu 24.04, linux/amd64.
# Availability and official archive checksum verified: 2026-08-02.
# Accepted after deterministic rendering, real single-UE protocol validation,
# persistence, resource observation, upgrade, rollback, and scoped
# uninstall/reinstall gates completed on 2026-08-04.

HELM_VERSION='4.2.0'
HELM_GIT_COMMIT='0646808'
HELM_LINUX_AMD64_ARCHIVE_SHA256='97dbeb971be4ac4b27e3839976d9564c0fb35c6f3b1da89dd1e292d236af4096'
HELM_LINUX_AMD64_BINARY_SHA256='bf1e2f933afaaab981b4dce6f0caea951635539336f463780ad479de5408f869'
HELM_DOWNLOAD_URL='https://get.helm.sh/helm-v4.2.0-linux-amd64.tar.gz'

# Project-owned Helm identity. These names scope later lifecycle and cleanup
# commands; they are not credentials or live cluster state.
CN5G_HELM_RELEASE_NAME='cn5g'
CN5G_KUBERNETES_NAMESPACE='cn5g'
CN5G_CHART_VERSION='0.1.0'

# Exact route used only inside the disposable kind node to return the UE
# session subnet to the current UPF Pod. Protocol and metric distinguish this
# route from kernel/CNI routes and from the Networking qualification feasibility route.
CN5G_N6_RETURN_SUBNET='10.60.0.0/24'
CN5G_N6_RETURN_PROTOCOL='186'
CN5G_N6_RETURN_METRIC='46060'

SINGLE_UE_STATUS='accepted'
